{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "secrets": {
    "required": ["GOOGLE_PLACES_API_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
